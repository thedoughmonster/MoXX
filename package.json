{
  "name": "moxi-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Minimal production-shaped preorder web foundation.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "worker:types": "wrangler types",
    "worker:types:check": "wrangler types --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "cloudflare:dry-run": "wrangler deploy --dry-run --env preview --outdir .wrangler/dry-run-preview && wrangler deploy --dry-run --env production --outdir .wrangler/dry-run-production",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run worker:types:check && pnpm run test && pnpm run test:e2e && pnpm run build && pnpm run cloudflare:dry-run",
    "ci:check": "pnpm run check"
  },
  "dependencies": {
    "@sentry/react": "10.68.0",
    "@tanstack/react-query": "^5.101.4",
    "@xstate/react": "^6.1.0",
    "react": "19.2.8",
    "react-aria-components": "^1.19.0",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.83.0",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260728.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "packageManager": "pnpm@10.0.0"
}
