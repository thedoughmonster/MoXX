{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "warehouse-projection",
  "purpose": "Project durable Toast source events into canonical warehouse records.",
  "kind": "core_capability",
  "lifecycle_status": "active",
  "functions": ["momi-warehouse-projection-worker-v1"],
  "contracts": {
    "provides": ["momi.warehouse_projection.toast.consume.v1"],
    "consumes": [
      {
        "service": "momi-event-routing",
        "contract": "momi.events.delivery_lifecycle.v1"
      }
    ]
  },
  "database": {
    "read": [
      "legacy_recipe_staging",
      "momi_api",
      "momi_events",
      "toast_acquisition",
      "toast_raw",
      "warehouse_projection"
    ],
    "write": [
      "legacy_recipe_staging",
      "momi_events",
      "momi_warehouse",
      "toast_acquisition",
      "warehouse_projection"
    ]
  },
  "network": { "outbound_hosts": [] },
  "secrets": ["SUPABASE_DB_URL"],
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": []
}
