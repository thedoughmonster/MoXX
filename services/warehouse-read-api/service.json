{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "warehouse-read-api",
  "purpose": "Authorize and serve versioned canonical warehouse read contracts.",
  "kind": "core_capability",
  "service_type": "read_facade",
  "lifecycle_status": "active",
  "functions": [
    "momi-orders-get-by-id-v1",
    "momi-orders-get-by-version-v1",
    "momi-warehouse-payments-get-by-id-v1",
    "momi-warehouse-menu-entities-get-by-id-v1",
    "momi-warehouse-employees-get-by-id-v1",
    "momi-warehouse-schedules-get-by-id-v1",
    "momi-warehouse-stock-observations-get-by-id-v1"
  ],
  "contracts": {
    "provides": [
      "momi.orders.get_by_id.v1",
      "momi.orders.get_by_version.v1",
      "momi.payments.get_by_id.v1",
      "momi.menu_entities.get_by_id.v1",
      "momi.employees.get_by_id.v1",
      "momi.schedules.get_by_id.v1",
      "momi.stock_observations.get_latest.v1"
    ],
    "consumes": [
      { "service": "warehouse-projection", "contract": "momi.warehouse.canonical_read_views.v1" }
    ]
  },
  "database": {
    "read": ["momi_api", "momi_warehouse"],
    "write": ["momi_api.read_capabilities"]
  },
  "network": { "outbound_hosts": [] },
  "secrets": ["SUPABASE_DB_URL"],
  "configuration": [],
  "deployment": { "owns": [], "depends_on": [] },
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": [],
  "owned_dataset": {
    "dataset_key": "momi.canonical_read_authorization",
    "dataset_class": "operational",
    "private_relations": [
      "momi_api.read_capabilities",
      "momi_api.read_view_registry"
    ],
    "private_routines": [
      "momi_api.consume_read_capability",
      "momi_api.consume_versioned_read_capability"
    ],
    "public_reads": [],
    "public_commands": [],
    "emitted_events": []
  }
}
