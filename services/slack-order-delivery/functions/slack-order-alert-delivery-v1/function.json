  "runtime": "supabase_edge",
  "route_path": "/functions/v1/slack-order-alert-delivery-v1",
  "authentication_policy_key": "durable.work_token.v1",
  "entrypoint": "index.ts",
  "input_schema": "contracts/input.schema.json",
  "output_schema": "contracts/output.schema.json",
  "idempotency_policy_key": "momi.alert.candidate.v1",
  "required_capabilities": [
    "database_read",
    "database_write",
    "slack_http"
