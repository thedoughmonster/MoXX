{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "toast-order-ingest",
  "purpose": "Authenticate Toast order webhooks and submit complete evidence for archival.",
  "kind": "source_adapter",
  "service_type": "procurement_adapter",
  "lifecycle_status": "active",
  "functions": ["toast-orders-webhook-ingest-v1"],
  "contracts": {
    "provides": ["toast.orders.webhook_ingest.v1"],
    "consumes": [
      { "service": "order-alerting", "contract": "toast.order.webhook_alert_work.v1" }
    ]
  },
  "database": {
    "read": ["toast_hydration", "momi_api"],
    "write": ["toast_raw", "momi_orders"]
  },
  "network": { "outbound_hosts": [] },
  "secrets": ["SUPABASE_DB_URL", "TOAST_ORDERS_WEBHOOK_SECRET"],
  "configuration": [],
  "deployment": { "owns": [], "depends_on": [] },
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": []
}
