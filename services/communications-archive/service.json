{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "communications-archive",
  "purpose": "Preserve channel-neutral communications and evaluate durable archive items.",
  "kind": "core_capability",
  "lifecycle_status": "active",
  "functions": [
    "momi-communications-capture-openai-message-v1",
    "momi-communications-evaluate-item-v1"
  ],
  "contracts": {
    "provides": [
      "momi.communications.capture_openai_message.v1",
      "momi.communications.capture_operational_note.v1",
      "momi.communications.evaluate_item.v1",
      "momi.communications.dispatch_evaluation_job.v1",
      "momi.communications.get_evaluation_job_status.v1",
      "momi.communications.get_evaluation_queue_status.v1"
    ],
    "consumes": []
  },
  "database": {
    "read": ["momi_communications"],
    "write": ["momi_communications"]
  },
  "network": { "outbound_hosts": ["api.openai.com"] },
  "secrets": [
    "SUPABASE_DB_URL",
    "OPENAI_API_KEY",
    "MOMI_COMMUNICATIONS_EVALUATOR_MODEL"
  ],
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": []
}
