{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "order-alerting",
  "purpose": "Evaluate owned order documents against configured alert rules and create durable delivery work.",
  "kind": "core_capability",
  "lifecycle_status": "active",
  "functions": ["momi-order-alert-worker-v1"],
  "contracts": {
    "provides": [
      "momi.orders.alert.evaluate.v1",
      "momi.order_alert.delivery_work.v1"
    ],
    "consumes": [
      {
        "service": "toast-order-ingest",
        "contract": "toast.order.webhook_alert_work.v1"
      },
      {
        "service": "toast-order-hydration",
        "contract": "momi.order_api.invocation_work.v1"
      },
      {
        "service": "toast-order-read-api",
        "contract": "momi.toast_orders.get_by_id.v1"
      }
    ]
  },
  "database": {
    "read": ["momi_runtime", "momi_orders", "momi_alerting"],
    "write": ["momi_orders", "momi_alerting"]
  },
  "network": { "outbound_hosts": ["same-origin:supabase-edge-functions"] },
  "secrets": [
    "SUPABASE_DB_URL",
    "SUPABASE_URL",
    "SUPABASE_PUBLISHABLE_KEYS",
    "MOMI_CODE_COMMIT_SHA",
    "DENO_DEPLOYMENT_ID"
  ],
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": []
}
