{
  "function_key": "momi.orders.alert.evaluate.v1",
  "contract_version": 1,
  "purpose": "Consume one exact canonical order delivery, evaluate its owned order, and create durable delivery work.",
  "owner_service": "order-alerting",
  "function_type": "action",
  "capability": "decide",
  "boundary": "momi_internal",
  "runtime": "supabase_edge",
  "route_path": "/functions/v1/momi-order-alert-worker-v1",
  "authentication_policy_key": "momi.order_alert.delivery_capability_or_work_token.v1",
  "entrypoint": "index.ts",
  "input_schema": "contracts/input.schema.json",
  "output_schema": "contracts/output.schema.json",
  "idempotency_policy_key": "momi.alert.candidate.v1",
  "retry_policy_key": "momi.event.delivery.retry.v1",
  "required_capabilities": [
    "database_read",
    "database_write",
    "canonical_read_capability_manage",
    "momi_order_api_http",
    "queue_consume"
  ],
  "declared_side_effects": [
    "records_order_api_invocation_attempt",
    "issues_exact_canonical_read_capability",
    "revokes_exact_canonical_read_capability",
    "claims_order_alert_candidate",
    "completes_order_api_invocation_work",
    "queues_configured_delivery_work",
    "acknowledges_exact_order_event_delivery",
    "ignores_non_live_order_events",
    "schedules_event_delivery_retry",
    "dead_letters_event_delivery"
  ]
}
