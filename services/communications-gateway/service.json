{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "communications-gateway",
  "purpose": "Admit and orchestrate bounded provider-neutral MoMi assistant turns.",
  "kind": "core_capability",
  "service_type": "dataset_owner",
  "lifecycle_status": "active",
  "functions": ["momi-communications-gateway-v1"],
  "contracts": {
    "provides": [
      "momi.communications.list_models.v1",
      "momi.communications.chat_completions.v1",
      "momi.communications.get_conversation_execution.v1",
      "momi.communications.set_user_limits.v1",
      "momi.communications.set_user_access.v1",
      "momi.communications.set_gateway_state.v1"
    ],
    "consumes": [
      {"service": "communications-archive", "contract": "momi.communications.capture_gateway_exchange.v1"},
      {"service": "communications-archive", "contract": "momi.communications.get_gateway_exchange_receipt.v1"},
      {"service": "communications-operations", "contract": "momi.communications.create_user_flagged_shop_log.v1"},
      {"service": "warehouse-read-api", "contract": "momi.canonical_beta_query.v1"}
    ]
  },
  "database": {
    "read": [
      "momi_api",
      "momi_communications",
      "momi_communications_gateway",
      "momi_communications_operations"
    ],
    "write": ["momi_communications_gateway"]
  },
  "network": {"outbound_hosts": ["api.openai.com"]},
  "secrets": [
    "SUPABASE_DB_URL",
    "MOMI_BETA_PROVIDER_API_KEY",
    "MOMI_OPENWEBUI_GATEWAY_SECRET",
    "MOMI_GATEWAY_ADMIN_SECRET"
  ],
  "configuration": ["MOMI_BETA_ADMIN_USER_ID"],
  "deployment": {"owns": [], "depends_on": []},
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": [],
  "owned_dataset": {
    "dataset_key": "momi.communications_gateway",
    "dataset_class": "operational",
    "private_schema": "momi_communications_gateway",
    "private_relations": [
      "momi_communications_gateway.access_entries",
      "momi_communications_gateway.audit_events",
      "momi_communications_gateway.gateway_state",
      "momi_communications_gateway.invocations",
      "momi_communications_gateway.provider_bindings",
      "momi_communications_gateway.user_limits"
    ],
    "private_routines": [
      "momi_communications_gateway.admit_invocation_v1",
      "momi_communications_gateway.complete_invocation_v1",
      "momi_communications_gateway.get_conversation_execution_v1",
      "momi_communications_gateway.list_models_v1",
      "momi_communications_gateway.mark_archive_admitted_v1",
      "momi_communications_gateway.mark_provider_started_v1",
      "momi_communications_gateway.set_gateway_state_v1",
      "momi_communications_gateway.set_user_access_v1",
      "momi_communications_gateway.set_user_limits_v1"
    ],
    "public_reads": [
      "momi.communications.get_conversation_execution.v1",
      "momi.communications.list_models.v1"
    ],
    "public_commands": [
      "momi.communications.chat_completions.v1",
      "momi.communications.set_user_limits.v1",
      "momi.communications.set_user_access.v1",
      "momi.communications.set_gateway_state.v1"
    ],
    "public_routine_reads": [
      {"contract": "momi.communications.get_conversation_execution.v1", "routine": "momi_communications_gateway.get_conversation_execution_v1"},
      {"contract": "momi.communications.list_models.v1", "routine": "momi_communications_gateway.list_models_v1"}
    ],
    "public_routine_commands": [
      {"contract": "momi.communications.chat_completions.v1", "routine": "momi_communications_gateway.admit_invocation_v1"},
      {"contract": "momi.communications.set_user_limits.v1", "routine": "momi_communications_gateway.set_user_limits_v1"},
      {"contract": "momi.communications.set_user_access.v1", "routine": "momi_communications_gateway.set_user_access_v1"},
      {"contract": "momi.communications.set_gateway_state.v1", "routine": "momi_communications_gateway.set_gateway_state_v1"}
    ],
    "emitted_events": []
  }
}
