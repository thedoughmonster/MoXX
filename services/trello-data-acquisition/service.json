{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "trello-data-acquisition",
  "purpose": "Acquire allowlisted Trello resources and own durable acquisition control.",
  "kind": "source_adapter",
  "service_type": "procurement_adapter",
  "lifecycle_status": "active",
  "functions": ["trello-board-snapshot-v1"],
  "contracts": {
    "provides": ["trello.data.acquisition.request.v1"],
    "consumes": []
  },
  "database": { "read": ["trello_acquisition"], "write": ["trello_acquisition"] },
  "network": { "outbound_hosts": ["api.trello.com"] },
  "secrets": ["SUPABASE_DB_URL", "TRELLO_API_KEY", "TRELLO_API_TOKEN"],
  "configuration": [],
  "deployment": { "owns": [], "depends_on": [] },
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": [],
  "owned_dataset": {
    "dataset_key": "trello.acquisition_control",
    "dataset_class": "operational",
    "private_schema": "trello_acquisition",
    "private_relations": ["trello_acquisition.board_snapshot_jobs"],
    "private_routines": [
      "trello_acquisition.claim_board_snapshot_v1",
      "trello_acquisition.enqueue_board_snapshot_v1",
      "trello_acquisition.finish_board_snapshot_v1"
    ],
    "public_reads": [],
    "public_commands": ["trello.data.acquisition.request.v1"],
    "public_routine_commands": [
      {
        "contract": "trello.data.acquisition.request.v1",
        "routine": "trello_acquisition.enqueue_board_snapshot_v1"
      }
    ],
    "emitted_events": []
  }
}
