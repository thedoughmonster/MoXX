{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "toast-data-acquisition",
  "purpose": "Acquire allowlisted Toast resources for durable jobs and preserve complete source evidence.",
  "kind": "source_adapter",
  "lifecycle_status": "active",
  "functions": ["toast-data-acquisition-v1"],
  "contracts": {
    "provides": ["toast.data.acquisition.v1"],
    "consumes": []
  },
  "database": {
    "read": ["toast_acquisition"],
    "write": ["toast_acquisition", "toast_raw"]
  },
  "network": {
    "outbound_hosts": ["configured:toast_acquisition.sources.api_base_url"]
  },
  "secrets": ["SUPABASE_DB_URL", "TOAST_CLIENT_ID", "TOAST_CLIENT_SECRET"],
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": []
}
