{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "momi://momi.slack.order_alert.deliver.v1/output",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "disposition", "work_id"],
  "properties": {
    "ok": { "type": "boolean" },
    "disposition": {
      "enum": [
        "sent",
        "already_succeeded",
        "unavailable",
        "not_found",
        "failed"
      ]
    },
    "work_id": { "type": "string" },
    "attempt_id": { "type": "string" },
    "invocation_id": { "type": "string" },
    "channel": { "type": "string" },
    "ts": { "type": "string" },
    "error": { "type": "string" }
  }
}
