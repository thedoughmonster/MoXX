{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "momi://toast.orders.fetch_by_guid.v1/input",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "trigger_token"],
  "properties": {
    "job_id": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]*$",
          "maxLength": 19
        }
      ]
    },
    "trigger_token": {
      "type": "string",
      "format": "uuid"
    }
  }
}
