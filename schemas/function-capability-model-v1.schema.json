{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momi.local/schemas/function-capability-model-v1.schema.json",
  "title": "Function Capability Model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "source_snapshot", "functions", "digest"],
  "properties": {
    "$schema": { "const": "https://momi.local/schemas/function-capability-model-v1.schema.json" },
    "schema_version": { "const": 1 },
    "source_snapshot": { "$ref": "#/$defs/source_snapshot" },
    "functions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/function" } },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "service": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "contract": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*\\.v[1-9][0-9]*$" },
    "called_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["service", "contract"],
      "properties": {
        "service": { "$ref": "#/$defs/service" },
        "contract": { "$ref": "#/$defs/contract" }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "consumer", "contract"],
      "properties": {
        "provider": { "$ref": "#/$defs/service" },
        "consumer": { "$ref": "#/$defs/service" },
        "contract": { "$ref": "#/$defs/contract" }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_kind", "target", "provider_service", "source_path", "source_pointer", "provenance_paths"],
      "properties": {
        "effect_kind": {
          "enum": ["approved_package", "database_read", "database_write", "network_outbound_host", "runtime_dependency", "secret_reference"]
        },
        "target": { "type": "string", "minLength": 1 },
        "provider_service": { "$ref": "#/$defs/service" },
        "source_path": { "type": "string", "pattern": "^services/[a-z][a-z0-9-]+/service\\.json$" },
        "source_pointer": { "type": "string", "pattern": "^/" },
        "provenance_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/edge" } }
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function_key", "owner_service", "manifest_path", "direct_capabilities", "called_contracts", "transitive_effects"],
      "properties": {
        "function_key": { "type": "string", "pattern": "^[a-z][a-z0-9_.]+\\.v[0-9]+$" },
        "owner_service": { "$ref": "#/$defs/service" },
        "manifest_path": { "type": "string", "pattern": "^services/[a-z][a-z0-9-]+/functions/[a-z0-9-]+-v[0-9]+/function\\.json$" },
        "direct_capabilities": { "type": "array", "uniqueItems": true, "items": { "enum": ["database_read", "database_write"] } },
        "called_contracts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/called_contract" } },
        "transitive_effects": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/effect" } }
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "digest"],
      "properties": {
        "identity": { "$ref": "#/$defs/snapshot_identity" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    },
    "snapshot_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "schema_version", "repository", "branch", "commit", "service_manifest_schema", "function_manifest_schema", "architecture_contract_version"],
      "properties": {
        "$schema": { "const": "https://momi.local/schemas/architecture-snapshot-identity-v1.schema.json" },
        "schema_version": { "const": 1 },
        "repository": { "const": "thedoughmonster/momi-backend" },
        "branch": { "const": "dev" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "service_manifest_schema": { "$ref": "#/$defs/service_manifest_schema" },
        "function_manifest_schema": { "$ref": "#/$defs/function_manifest_schema" },
        "architecture_contract_version": { "const": 2 }
      }
    },
    "service_manifest_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "https://momi.local/schemas/service-manifest-v1.schema.json" },
        "version": { "const": 1 }
      }
    },
    "function_manifest_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "https://momi.local/schemas/function-manifest-v1.schema.json" },
        "version": { "const": 1 }
      }
    }
  }
}
