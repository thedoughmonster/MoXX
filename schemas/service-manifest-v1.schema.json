{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momi.local/schemas/service-manifest-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "service_key", "purpose", "kind", "lifecycle_status",
    "functions", "contracts", "database", "network", "secrets",
    "runtime_dependencies", "approved_packages"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "service_key": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "purpose": { "type": "string", "minLength": 20 },
    "kind": {
      "enum": ["source_adapter", "core_capability", "destination_adapter"]
    },
    "lifecycle_status": { "enum": ["active", "retiring", "retired"] },
    "functions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+-v[0-9]+$" }
    },
    "contracts": {
      "type": "object", "additionalProperties": false,
      "required": ["provides", "consumes"],
      "properties": {
        "provides": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]+\\.v[0-9]+$" }
        },
        "consumes": {
          "type": "array",
          "items": { "$ref": "#/$defs/consumed_contract" }
        }
      }
    },
    "database": {
      "type": "object", "additionalProperties": false,
      "required": ["read", "write"],
      "properties": {
        "read": { "$ref": "#/$defs/string_set" },
        "write": { "$ref": "#/$defs/string_set" }
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["outbound_hosts"],
      "properties": { "outbound_hosts": { "$ref": "#/$defs/string_set" } }
    },
    "secrets": { "$ref": "#/$defs/string_set" },
    "runtime_dependencies": { "$ref": "#/$defs/string_set" },
    "approved_packages": { "$ref": "#/$defs/string_set" }
  },
  "$defs": {
    "string_set": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "consumed_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["service", "contract"],
      "properties": {
        "service": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "contract": { "type": "string", "pattern": "^[a-z][a-z0-9_.]+\\.v[0-9]+$" }
      }
    }
  }
}
