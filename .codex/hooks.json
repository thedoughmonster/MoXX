{
  "description": "MoXX monorepo edit guards and diagnostics.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/run-momi-codex-hook.mjs\" pre",
            "timeout": 5,
            "statusMessage": "Checking trusted MoMi production migration history"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/run-momi-codex-hook.mjs\" post",
            "timeout": 20,
            "statusMessage": "Inspecting changed MoMi files",
            "additionalContextLimit": 4000
          }
        ]
      }
    ]
  }
}
