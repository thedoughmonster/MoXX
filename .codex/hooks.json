{
  "description": "MoMi repository edit guards.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/run_codex_migration_guard.ts\"",
            "timeout": 5,
            "statusMessage": "Checking trusted production migration history"
          }
        ]
      }
    ]
  }
}
