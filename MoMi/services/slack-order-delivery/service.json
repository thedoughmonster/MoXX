{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "slack-order-delivery",
  "purpose": "Deliver prepared order alerts and own Slack delivery operations.",
  "kind": "destination_adapter",
  "service_type": "destination_adapter",
  "lifecycle_status": "active",
  "functions": ["slack-order-alert-delivery-v1"],
  "contracts": {
    "provides": ["momi.slack.order_alert.deliver.v1"],
    "consumes": []
  },
  "database": {
    "read": ["momi_runtime", "momi_alerting"],
    "write": ["momi_alerting"]
  },
  "network": { "outbound_hosts": ["slack.com"] },
  "secrets": ["SUPABASE_DB_URL", "SLACK_BOT_TOKEN"],
  "configuration": ["MOMI_CODE_COMMIT_SHA", "DENO_DEPLOYMENT_ID"],
  "deployment": {
    "owns": [],
    "depends_on": [
      { "kind": "postgres_extension", "key": "pg_net" },
      { "kind": "vault_secret", "key": "momi_project_url" },
      { "kind": "vault_secret", "key": "momi_publishable_key" }
    ]
  },
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": [],
  "owned_dataset": {
    "dataset_key": "momi.slack_delivery",
    "dataset_class": "operational",
    "private_relations": [
      "momi_alerting.slack_delivery_attempts",
      "momi_alerting.slack_delivery_work",
      "momi_alerting.slack_destinations",
      "momi_alerting.slack_order_alert_messages_v1"
    ],
    "private_routines": [
      "momi_alerting.enqueue_slack_order_alert_delivery",
      "momi_alerting.wake_slack_delivery_worker"
    ],
    "public_reads": [],
    "public_commands": ["momi.slack.order_alert.deliver.v1"],
    "emitted_events": []
  }
}
