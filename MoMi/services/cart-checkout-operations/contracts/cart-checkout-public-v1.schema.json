{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momi.local/contracts/cart-checkout-public-v1.schema.json",
  "title": "MoMi Shared Cart and Checkout Contracts v1",
  "description": "Declared source-neutral shapes. They are non-callable until separately bound to an implementation.",
  "x-momi-contracts": {
    "momi.cart_checkout.cart.read.v1": { "request": "#/$defs/CartReadRequest", "response": "#/$defs/CartReadResponse" },
    "momi.cart_checkout.checkout.command.v1": { "request": "#/$defs/CheckoutCommandRequest", "response": "#/$defs/CheckoutStatusResponse" },
    "momi.cart_checkout.checkout.recover.v1": { "request": "#/$defs/CheckoutRecoveryRequest", "response": "#/$defs/CheckoutStatusResponse" },
    "momi.cart_checkout.checkout.status.read.v1": { "request": "#/$defs/CheckoutStatusRequest", "response": "#/$defs/CheckoutStatusResponse" },
    "momi.cart_checkout.draft_order.mutate.v1": { "request": "#/$defs/DraftOrderMutationRequest", "response": "#/$defs/DraftOrderMutationResponse" },
    "momi.cart_checkout.draft_order.read.v1": { "request": "#/$defs/DraftOrderReadRequest", "response": "#/$defs/DraftOrderReadResponse" },
    "momi.cart_checkout.flow_contribution.revalidate.v1": { "request": "#/$defs/RevalidationRequest", "response": "#/$defs/RevalidationResponse" },
    "momi.cart_checkout.flow_contribution.submit.v1": { "request": "#/$defs/FlowContributionRequest", "response": "#/$defs/DraftOrderMutationResponse" },
    "momi.cart_checkout.order_change.reference.v1": { "payload": "#/$defs/OrderChangeReference" }
  },
  "$defs": {
    "Identifier": { "type": "string", "format": "uuid" },
    "Timestamp": { "type": "string", "format": "date-time" },
    "ContractKey": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*\\.v[1-9][0-9]*$" },
    "StableKey": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "Money": { "type": "object", "additionalProperties": false, "required": ["currency", "amount_minor"], "properties": { "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "amount_minor": { "type": "integer" } } },
    "OwnerReadReference": { "type": "object", "additionalProperties": false, "required": ["owner_service", "contract_key", "resource_id", "resource_version"], "properties": { "owner_service": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }, "contract_key": { "$ref": "#/$defs/ContractKey" }, "resource_id": { "$ref": "#/$defs/Identifier" }, "resource_version": { "type": "integer", "minimum": 1 } } },
    "RuleReference": { "allOf": [{ "$ref": "#/$defs/OwnerReadReference" }], "description": "Flow-owned policy or fulfillment evidence; the policy body is not copied." },
    "FlowContribution": { "type": "object", "additionalProperties": false, "required": ["contribution_id", "flow_key", "source_ref", "product_ref", "quantity", "fulfillment_ref", "rule_refs", "disclosures", "revalidation_ref"], "properties": { "contribution_id": { "$ref": "#/$defs/Identifier" }, "flow_key": { "$ref": "#/$defs/StableKey" }, "source_ref": { "$ref": "#/$defs/OwnerReadReference" }, "product_ref": { "$ref": "#/$defs/OwnerReadReference" }, "quantity": { "type": "integer", "minimum": 1, "maximum": 100 }, "option_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/OwnerReadReference" } }, "fulfillment_ref": { "$ref": "#/$defs/OwnerReadReference" }, "rule_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/RuleReference" } }, "disclosures": { "type": "array", "items": { "type": "string", "maxLength": 240 } }, "revalidation_ref": { "$ref": "#/$defs/OwnerReadReference" } } },
    "DraftOrderLine": { "type": "object", "additionalProperties": false, "required": ["line_id", "line_version", "contribution"], "properties": { "line_id": { "$ref": "#/$defs/Identifier" }, "line_version": { "type": "integer", "minimum": 1 }, "contribution": { "$ref": "#/$defs/FlowContribution" } } },
    "DraftOrder": { "type": "object", "additionalProperties": false, "description": "A draft is not a reservation, accepted order, payment authorization, or provider receipt.", "required": ["order_id", "order_version", "shopping_authority_id", "status", "lines", "total", "updated_at"], "properties": { "order_id": { "$ref": "#/$defs/Identifier" }, "order_version": { "type": "integer", "minimum": 1 }, "shopping_authority_id": { "$ref": "#/$defs/Identifier" }, "status": { "enum": ["draft", "checkout_in_progress", "placement_pending", "placed", "canceled", "expired"] }, "lines": { "type": "array", "items": { "$ref": "#/$defs/DraftOrderLine" } }, "total": { "$ref": "#/$defs/Money" }, "updated_at": { "$ref": "#/$defs/Timestamp" } } },
    "CommandOutcome": { "enum": ["accepted", "rejected", "conflict", "pending", "indeterminate"] },
    "NextAction": { "enum": ["refresh", "edit_cart", "provide_contact", "confirm_fulfillment", "retry_revalidation", "initiate_payment", "retry_payment", "recover", "view_confirmation", "contact_shop"] },
    "CustomerIssue": { "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable", "next_action"], "properties": { "code": { "enum": ["invalid", "stale", "unavailable", "price_changed", "fulfillment_changed", "capacity_changed", "cutoff_passed", "payment_declined", "payment_indeterminate"] }, "message": { "type": "string", "maxLength": 240 }, "retryable": { "type": "boolean" }, "next_action": { "$ref": "#/$defs/NextAction" } } },
    "CustomerSafeState": { "enum": ["loading", "empty", "incomplete", "ready", "invalid", "stale", "pending", "declined", "indeterminate", "recovery_required", "confirmed"] },
    "DraftOrderMutationRequest": { "type": "object", "additionalProperties": false, "required": ["command_id", "shopping_authority_id", "expected_order_version", "action"], "properties": { "command_id": { "$ref": "#/$defs/Identifier" }, "shopping_authority_id": { "$ref": "#/$defs/Identifier" }, "order_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] }, "expected_order_version": { "type": ["integer", "null"], "minimum": 1 }, "action": { "enum": ["contribute", "replace", "remove", "clear"] }, "line_id": { "$ref": "#/$defs/Identifier" }, "contribution": { "$ref": "#/$defs/FlowContribution" } } },
    "DraftOrderMutationResponse": { "type": "object", "additionalProperties": false, "required": ["outcome", "order", "next_actions", "issues"], "properties": { "outcome": { "$ref": "#/$defs/CommandOutcome" }, "order": { "oneOf": [{ "$ref": "#/$defs/DraftOrder" }, { "type": "null" }] }, "next_actions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/NextAction" } }, "issues": { "type": "array", "items": { "$ref": "#/$defs/CustomerIssue" } } } },
    "DraftOrderReadRequest": { "type": "object", "additionalProperties": false, "required": ["order_id"], "properties": { "order_id": { "$ref": "#/$defs/Identifier" } } },
    "DraftOrderReadResponse": { "type": "object", "additionalProperties": false, "required": ["order"], "properties": { "order": { "$ref": "#/$defs/DraftOrder" } } },
    "FlowContributionRequest": { "type": "object", "additionalProperties": false, "required": ["command_id", "shopping_authority_id", "expected_order_version", "contribution"], "properties": { "command_id": { "$ref": "#/$defs/Identifier" }, "shopping_authority_id": { "$ref": "#/$defs/Identifier" }, "order_id": { "oneOf": [{ "$ref": "#/$defs/Identifier" }, { "type": "null" }] }, "expected_order_version": { "type": ["integer", "null"], "minimum": 1 }, "contribution": { "$ref": "#/$defs/FlowContribution" } } },
    "RevalidationRequest": { "type": "object", "additionalProperties": false, "required": ["order_id", "expected_order_version", "contribution_refs"], "properties": { "order_id": { "$ref": "#/$defs/Identifier" }, "expected_order_version": { "type": "integer", "minimum": 1 }, "contribution_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/OwnerReadReference" } } } },
    "RevalidationResponse": { "type": "object", "additionalProperties": false, "required": ["outcome", "validated_order_version", "issues"], "properties": { "outcome": { "enum": ["valid", "stale", "rejected"] }, "validated_order_version": { "type": "integer", "minimum": 1 }, "issues": { "type": "array", "items": { "$ref": "#/$defs/CustomerIssue" } } } },
    "CartReadRequest": { "$ref": "#/$defs/DraftOrderReadRequest" },
    "CartReadResponse": { "type": "object", "additionalProperties": false, "required": ["customer_state", "projection_status", "order", "next_actions", "issues"], "properties": { "customer_state": { "$ref": "#/$defs/CustomerSafeState" }, "projection_status": { "enum": ["current", "stale", "recovering"] }, "order": { "oneOf": [{ "$ref": "#/$defs/DraftOrder" }, { "type": "null" }] }, "next_actions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/NextAction" } }, "issues": { "type": "array", "items": { "$ref": "#/$defs/CustomerIssue" } } } },
    "CustomerContact": { "type": "object", "additionalProperties": false, "required": ["name"], "anyOf": [{ "required": ["email"] }, { "required": ["phone"] }], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 120 }, "email": { "type": "string", "format": "email", "maxLength": 254 }, "phone": { "type": "string", "minLength": 7, "maxLength": 32 } } },
    "CheckoutCommandRequest": { "type": "object", "additionalProperties": false, "required": ["command_id", "order_id", "expected_order_version", "action"], "properties": { "command_id": { "$ref": "#/$defs/Identifier" }, "order_id": { "$ref": "#/$defs/Identifier" }, "expected_order_version": { "type": "integer", "minimum": 1 }, "action": { "enum": ["begin", "save_contact", "confirm_fulfillment", "revalidate", "place", "resume"] }, "contact": { "$ref": "#/$defs/CustomerContact" }, "fulfillment_ref": { "$ref": "#/$defs/OwnerReadReference" } } },
    "CheckoutStatusRequest": { "$ref": "#/$defs/DraftOrderReadRequest" },
    "CheckoutRecoveryRequest": { "type": "object", "additionalProperties": false, "required": ["command_id", "order_id", "expected_order_version", "expected_checkout_version"], "properties": { "command_id": { "$ref": "#/$defs/Identifier" }, "order_id": { "$ref": "#/$defs/Identifier" }, "expected_order_version": { "type": "integer", "minimum": 1 }, "expected_checkout_version": { "type": "integer", "minimum": 1 } } },
    "CheckoutStatusResponse": { "type": "object", "additionalProperties": false, "required": ["order_id", "order_version", "checkout_version", "customer_state", "phase", "payment_status", "next_actions", "issues", "confirmation_ref"], "properties": { "order_id": { "$ref": "#/$defs/Identifier" }, "order_version": { "type": "integer", "minimum": 1 }, "checkout_version": { "type": "integer", "minimum": 1 }, "customer_state": { "$ref": "#/$defs/CustomerSafeState" }, "phase": { "enum": ["review", "contact", "fulfillment", "revalidation", "payment_required", "pending", "recovery", "confirmed"] }, "payment_status": { "enum": ["not_started", "required", "pending", "declined", "indeterminate", "paid"] }, "next_actions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/NextAction" } }, "issues": { "type": "array", "items": { "$ref": "#/$defs/CustomerIssue" } }, "confirmation_ref": { "oneOf": [{ "$ref": "#/$defs/OwnerReadReference" }, { "type": "null" }] } } },
    "OrderChangeReference": { "type": "object", "additionalProperties": false, "required": ["event_id", "change_id", "order_id", "order_version", "owner_read_ref", "occurred_at"], "properties": { "event_id": { "$ref": "#/$defs/Identifier" }, "change_id": { "$ref": "#/$defs/Identifier" }, "order_id": { "$ref": "#/$defs/Identifier" }, "order_version": { "type": "integer", "minimum": 1 }, "owner_read_ref": { "$ref": "#/$defs/OwnerReadReference" }, "occurred_at": { "$ref": "#/$defs/Timestamp" } } }
  }
}
