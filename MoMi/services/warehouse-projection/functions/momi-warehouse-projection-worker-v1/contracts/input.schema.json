{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "momi://momi.warehouse_projection.toast.consume.v1/input",
  "title": "MoMi Toast warehouse projection delivery trigger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "message_id", "capability_token"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "message_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "capability_token": { "type": "string", "format": "uuid" }
  }
}
