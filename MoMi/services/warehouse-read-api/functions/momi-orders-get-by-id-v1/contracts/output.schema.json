{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "momi://momi.orders.get_by_id.v1/output",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "contract_key", "contract_version", "trace_id",
        "work_id", "order_id", "schema_version", "order_document",
        "order_presentation", "provenance", "freshness"],
      "properties": {
        "ok": { "const": true },
        "contract_key": { "const": "momi.orders.get_by_id.v1" },
        "contract_version": { "const": 1 },
        "trace_id": { "type": "string", "format": "uuid" },
        "work_id": { "type": "string" },
        "order_id": { "type": "string", "format": "uuid" },
        "schema_version": { "type": "integer", "minimum": 1 },
        "order_document": { "type": "object" },
        "order_presentation": { "type": "object" },
        "provenance": { "type": "object" },
        "freshness": { "type": "object" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "contract_key", "contract_version", "trace_id", "error"],
      "properties": {
        "ok": { "const": false },
        "contract_key": { "const": "momi.orders.get_by_id.v1" },
        "contract_version": { "const": 1 },
        "trace_id": { "type": "string", "format": "uuid" },
        "work_id": { "type": "string" },
        "error": { "enum": ["invalid_request", "forbidden",
          "contract_inactive", "order_not_found", "read_failed"] }
      }
    }
  ]
}
