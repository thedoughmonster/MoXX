{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluation_job_id", "capability_token"],
  "properties": {
    "evaluation_job_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "capability_token": {
      "type": "string",
      "format": "uuid"
    }
  }
}
