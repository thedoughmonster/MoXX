{
  "$schema": "../../schemas/service-manifest-v1.schema.json",
  "schema_version": 1,
  "service_key": "trello-data-acquisition",
  "purpose": "Acquire allowlisted Trello resources and own durable acquisition control.",
  "kind": "source_adapter",
  "service_type": "procurement_adapter",
  "lifecycle_status": "active",
  "functions": ["trello-board-snapshot-v1", "trello-webhook-inventory-v1"],
  "contracts": {
    "provides": ["trello.data.acquisition.request.v1"],
    "consumes": []
  },
  "database": { "read": ["trello_acquisition"], "write": ["trello_acquisition"] },
  "network": { "outbound_hosts": ["api.trello.com"] },
  "secrets": ["SUPABASE_DB_URL", "TRELLO_API_KEY", "TRELLO_API_TOKEN"],
  "configuration": [],
  "deployment": {
    "owns": [
      {
        "kind": "cron_job",
        "key": "momi-trello-board-snapshot-dispatch-recovery-v1"
      }
    ],
    "depends_on": [
      { "kind": "postgres_extension", "key": "pg_cron" },
      { "kind": "postgres_extension", "key": "pg_net" },
      { "kind": "vault_secret", "key": "momi_project_url" },
      { "kind": "vault_secret", "key": "momi_publishable_key" }
    ]
  },
  "runtime_dependencies": [
    "jsr:@supabase/functions-js@2.110.2/edge-runtime.d.ts",
    "npm:postgres@3.4.3"
  ],
  "approved_packages": [],
  "owned_dataset": {
    "dataset_key": "trello.acquisition_control",
    "dataset_class": "operational",
    "private_schema": "trello_acquisition",
    "private_relations": [
      "trello_acquisition.board_snapshot_jobs",
      "trello_acquisition.webhook_inventory_jobs"
    ],
    "private_routines": [
      "trello_acquisition.claim_board_snapshot_v1",
      "trello_acquisition.enqueue_board_snapshot_v1",
      "trello_acquisition.finish_board_snapshot_v1",
      "trello_acquisition.run_board_snapshot_dispatch_recovery_v1",
      "trello_acquisition.wake_board_snapshot_dispatch",
      "trello_acquisition.claim_webhook_inventory_v1",
      "trello_acquisition.enqueue_webhook_inventory_v1",
      "trello_acquisition.finish_webhook_inventory_v1"
    ],
    "public_reads": [],
    "public_commands": ["trello.data.acquisition.request.v1"],
    "public_routine_commands": [
      {
        "contract": "trello.data.acquisition.request.v1",
        "routine": "trello_acquisition.enqueue_board_snapshot_v1"
      },
      {
        "contract": "trello.data.acquisition.request.v1",
        "routine": "trello_acquisition.enqueue_webhook_inventory_v1"
      }
    ],
    "emitted_events": []
  }
}
