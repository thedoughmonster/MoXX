{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "momi://square.payment.retrieve.v1/input",
  "title": "Square payment observation acquisition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["provider_payment_id", "order_id", "amount_minor", "currency", "location_id"],
  "properties": {
    "provider_payment_id": { "type": "string", "minLength": 1, "maxLength": 192 },
    "order_id": { "type": "string", "format": "uuid", "maxLength": 40 },
    "amount_minor": { "type": "integer", "minimum": 1 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "location_id": { "type": "string", "minLength": 1, "maxLength": 64 }
  }
}
