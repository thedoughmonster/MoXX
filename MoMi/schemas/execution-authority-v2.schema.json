{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momi.local/schemas/execution-authority-v2.schema.json",
  "title": "Execution Authority v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "grant_id", "work_item", "service", "repository", "base_revision", "source_digest", "filesystem", "database", "contracts", "network", "secrets", "packages", "external", "forbidden", "escalate_on", "provenance"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "execution-authority/v2" },
    "grant_id": { "type": "string", "pattern": "^ea-[a-z0-9][a-z0-9-]*$" },
    "work_item": { "type": "string", "pattern": "^MOX-[1-9][0-9]*$" },
    "service": { "$ref": "#/$defs/service" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "base_revision": { "$ref": "#/$defs/git_revision" },
    "source_digest": { "$ref": "#/$defs/sha256" },
    "filesystem": { "$ref": "#/$defs/filesystem" },
    "database": { "$ref": "#/$defs/database" },
    "contracts": { "type": "object", "additionalProperties": false, "required": ["call"], "properties": { "call": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/contract" } } } },
    "network": { "type": "object", "additionalProperties": false, "required": ["connect"], "properties": { "connect": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/network" } } } },
    "secrets": { "type": "object", "additionalProperties": false, "required": ["reference"], "properties": { "reference": { "$ref": "#/$defs/string_set" } } },
    "packages": { "type": "object", "additionalProperties": false, "required": ["use"], "properties": { "use": { "$ref": "#/$defs/string_set" } } },
    "external": { "type": "object", "additionalProperties": false, "required": ["invoke"], "properties": { "invoke": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/external" } } } },
    "forbidden": { "$ref": "#/$defs/forbidden" },
    "escalate_on": { "type": "array", "uniqueItems": true, "items": { "enum": ["allow_deny_overlap", "ambiguous_authority", "base_revision_drift", "contract_mismatch", "cross_owner_target", "debt_derived_authority", "external_authority_missing", "manifest_mismatch", "path_escape", "protected_operation", "provider_leakage", "secret_value", "unknown_version"] } },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "service": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "string_set": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "git_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "object", "additionalProperties": false, "required": ["path", "kind", "recursive"], "properties": { "path": { "type": "string", "minLength": 1 }, "kind": { "enum": ["file", "directory"] }, "recursive": { "type": "boolean" } }, "allOf": [{ "if": { "properties": { "kind": { "const": "file" } }, "required": ["kind"] }, "then": { "properties": { "recursive": { "const": false } } } }] },
    "filesystem": { "type": "object", "additionalProperties": false, "required": ["read", "write"], "properties": { "read": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } }, "write": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/path" } } } },
    "relation": { "type": "object", "additionalProperties": false, "required": ["class", "schema", "name"], "properties": { "class": { "const": "relation" }, "schema": { "$ref": "#/$defs/identifier" }, "name": { "$ref": "#/$defs/identifier" } } },
    "routine": { "type": "object", "additionalProperties": false, "required": ["class", "schema", "name", "arguments"], "properties": { "class": { "const": "routine" }, "schema": { "$ref": "#/$defs/identifier" }, "name": { "$ref": "#/$defs/identifier" }, "arguments": { "type": "array", "items": { "type": "string", "minLength": 1 } } } },
    "sequence": { "type": "object", "additionalProperties": false, "required": ["class", "schema", "name"], "properties": { "class": { "const": "sequence" }, "schema": { "$ref": "#/$defs/identifier" }, "name": { "$ref": "#/$defs/identifier" } } },
    "identity": { "oneOf": [{ "$ref": "#/$defs/relation" }, { "$ref": "#/$defs/routine" }, { "$ref": "#/$defs/sequence" }] },
    "capability": { "type": "object", "additionalProperties": false, "required": ["object", "mode"], "properties": { "object": { "$ref": "#/$defs/identity" }, "mode": { "enum": ["relation.read", "relation.write", "routine.call", "sequence.use"] } } },
    "database_pin": { "type": "object", "additionalProperties": false, "required": ["repository", "revision", "source_digest", "authority_digest"], "properties": { "repository": { "type": "string" }, "revision": { "$ref": "#/$defs/git_revision" }, "source_digest": { "$ref": "#/$defs/sha256" }, "authority_digest": { "$ref": "#/$defs/sha256" } } },
    "database": { "type": "object", "additionalProperties": false, "required": ["authority", "capabilities"], "properties": { "authority": { "$ref": "#/$defs/database_pin" }, "capabilities": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/capability" } } } },
    "contract": { "type": "object", "additionalProperties": false, "required": ["provider_service", "contract"], "properties": { "provider_service": { "$ref": "#/$defs/service" }, "contract": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*\\.v[1-9][0-9]*$" } } },
    "network": { "type": "object", "additionalProperties": false, "required": ["protocol", "host", "port"], "properties": { "protocol": { "enum": ["https", "wss", "postgres"] }, "host": { "type": "string", "minLength": 1 }, "port": { "type": "integer", "minimum": 1, "maximum": 65535 } } },
    "external": { "type": "object", "additionalProperties": false, "required": ["authority_key", "operation", "resource"], "properties": { "authority_key": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]+$" }, "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_.:-]+$" }, "resource": { "type": "string", "minLength": 1 } } },
    "external_action": { "type": "object", "additionalProperties": false, "required": ["authority_key", "operation", "resource"], "properties": { "authority_key": { "type": "string" }, "operation": { "type": "string" }, "resource": { "type": "string" } } },
    "forbidden": { "type": "object", "additionalProperties": false, "required": ["paths", "services", "database_objects", "contracts", "hosts", "secret_names", "external_actions", "operation_classes"], "properties": { "paths": { "$ref": "#/$defs/string_set" }, "services": { "$ref": "#/$defs/string_set" }, "database_objects": { "$ref": "#/$defs/string_set" }, "contracts": { "$ref": "#/$defs/string_set" }, "hosts": { "$ref": "#/$defs/string_set" }, "secret_names": { "$ref": "#/$defs/string_set" }, "external_actions": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/external_action" } }, "operation_classes": { "$ref": "#/$defs/string_set" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["source", "digest"], "properties": { "source": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/sha256" } } },
    "debt_evidence": { "type": "object", "additionalProperties": false, "required": ["source", "digest", "targets"], "properties": { "source": { "type": "string", "minLength": 1 }, "digest": { "$ref": "#/$defs/sha256" }, "targets": { "$ref": "#/$defs/string_set" } } },
    "evidence_set": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/evidence" } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["issue_authorization", "accepted_decisions", "repository_rules", "manifests", "contracts", "external_authorities", "runtime_observations", "legacy_debt"], "properties": { "issue_authorization": { "$ref": "#/$defs/evidence" }, "accepted_decisions": { "$ref": "#/$defs/evidence_set" }, "repository_rules": { "$ref": "#/$defs/evidence_set" }, "manifests": { "$ref": "#/$defs/evidence_set" }, "contracts": { "$ref": "#/$defs/evidence_set" }, "external_authorities": { "$ref": "#/$defs/evidence_set" }, "runtime_observations": { "$ref": "#/$defs/evidence_set" }, "legacy_debt": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/debt_evidence" } } } }
  }
}
