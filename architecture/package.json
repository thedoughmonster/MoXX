{
  "name": "moxx-architecture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "24.14.x",
    "pnpm": "11.7.x"
  },
  "scripts": {
    "build": "likec4 build --output dist",
    "catalog:check": "node scripts/check-catalog.mjs",
    "check": "pnpm run format:check && pnpm run validate && pnpm run lifecycle:check && pnpm run catalog:check && pnpm run build",
    "dev": "likec4 serve --listen ${LIKEC4_HOST:-127.0.0.1} --port ${LIKEC4_PORT:-5174} --no-react-hmr",
    "format": "likec4 format",
    "format:check": "likec4 format --check",
    "lifecycle:check": "likec4 export json --skip-layout --outfile .likec4/model.json && node scripts/check-lifecycle.mjs .likec4/model.json",
    "validate": "likec4 validate"
  },
  "devDependencies": {
    "likec4": "1.59.3"
  }
}
