views {
  style element.tag = #discovery {
    border dotted
    notation 'Lifecycle: discovery — unresolved and not committed for implementation'
  }

  style element.tag = #planned {
    border dashed
    notation 'Lifecycle: planned — accepted architecture, not yet verified operational'
  }

  style element.tag = #implemented {
    border solid
    notation 'Lifecycle: implemented — verified current behavior or data'
  }

  style element.tag = #legacy {
    opacity 60%
  }

  style element.tag = #moxx-owned {
    color green
  }

  style element.tag = #managed-platform {
    color indigo
  }

  style element.tag = #third-party {
    color gray
  }

  view index {
    title 'MOXX persistent costing landscape'
    description 'Current discovery, accepted plans, and verified evidence for persistent product costing.'

    include *
  }

  view costing_capabilities of costing {
    title 'Persistent costing capabilities'
    description 'Capability boundaries colored by lifecycle truth, not by desired future state.'

    include *
    include operator
    include sysco
    include future_supplier_channels
  }

  view cost_lookup {
    title 'Cost lookup'
    description 'The shortest path from a product lookup to an explainable materials-cost estimate.'

    include operator
    include costing.dashboard
    include costing.dashboard_api
    include costing.cost_calculation
    include costing.recipe_data
    include costing.purchase_cost_evidence
    include costing.ingredient_mapping
  }

  view cost_maintenance {
    title 'Invoice acquisition and cost maintenance'
    description 'How supplier evidence becomes cost evidence and how unresolved inputs return to durable source data.'

    include sysco
    include future_supplier_channels
    include costing.invoice_acquisition
    include costing.raw_artifact_store
    include costing.invoice_ingestion
    include costing.purchase_cost_evidence
    include costing.ingredient_mapping
    include costing.correction_workflow
    include operator
    include costing.recipe_data
  }
}
