{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moxi-web-preorder",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "env": {
    "preview": {
      "name": "moxi-web-preorder-preview",
      "workers_dev": true,
      "vars": {
        "APP_STAGE": "preview"
      }
    },
    "production": {
      "name": "moxi-web-preorder-production",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "preorder.dough.monster",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_STAGE": "production"
      }
    }
  }
}
