{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_number",
    "feature",
    "relationships",
    "safe_parallel",
    "confidence",
    "rationale",
    "labels"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+){0,5}$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_number", "type", "rationale"],
        "properties": {
          "issue_number": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "hard_prerequisite",
              "ordering_constraint",
              "shared_mutation_release_boundary",
              "external_user_gate",
              "independent"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        }
      }
    },
    "safe_parallel": {
      "type": "boolean"
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["enhancement"]
      }
    }
  }
}
