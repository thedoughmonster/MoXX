{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_number", "order", "title"],
      "properties": {
        "issue_number": { "type": "integer", "minimum": 1 },
        "order": { "type": "string", "pattern": "^[0-9]{2}[A-Z]?$" },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 248,
          "pattern": "^\\S(?:.*\\S)?$"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "initiative", "projects"],
  "properties": {
    "$schema": { "type": "string", "const": "./zenhub-roadmap.schema.json" },
    "schema_version": { "type": "integer", "const": 1 },
    "initiative": {
      "allOf": [
        { "$ref": "#/$defs/entry" },
        { "properties": { "order": { "const": "00" } } }
      ]
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "allOf": [
          { "$ref": "#/$defs/entry" },
          { "properties": { "order": { "pattern": "^(?:0[1-9]|[1-9][0-9])[A-Z]?$" } } }
        ]
      }
    }
  }
}
